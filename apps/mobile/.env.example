# Copy to .env and fill with your Supabase project's PUBLIC values.
# .env is gitignored — never commit real keys. Only EXPO_PUBLIC_* reaches the client bundle.
# Use the anon/public key ONLY. Never put a service-role key here or anywhere in the mobile app.
#
# Find these in: Supabase dashboard → Project Settings → API.
# If left as these placeholders, the app detects them and serves mock data (no network hang).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Sentry crash reporting is OFF unless this is set (non-empty).
# The DSN is a public client identifier, not a secret, but set it via EAS env vars for builds.
EXPO_PUBLIC_SENTRY_DSN=
